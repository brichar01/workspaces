{
  "name": "workspaces_workspace (podman)",
  "dockerComposeFile": [
    "../compose.yaml",
    "../compose.override.yaml",
    "../compose.podman.yaml",
    "compose.devcontainer.yaml"
  ],
  "service": "workspaces_dev",
  "runServices": ["workspaces_dev"],
  "workspaceFolder": "/workspace",
  "shutdownAction": "none",
  "overrideCommand": false,
  "remoteUser": "workspaces_user",
  "updateRemoteUserUID": false,
  "initializeCommand": "scripts/engine.sh preflight",
  "postCreateCommand": "just _post-create",
  "postStartCommand": "just _post-start",
  "waitFor": "postStartCommand",
  "customizations": {
    "vscode": {
      "extensions": []
    }
  }
}
