{
  "name": "hive-workspace",
  "dockerComposeFile": [
    "../compose.yaml",
    "../compose.override.yaml",
    "compose.devcontainer.yaml"
  ],
  "service": "agent",
  "runServices": ["agent"],
  "workspaceFolder": "/workspace",
  "shutdownAction": "none",
  "overrideCommand": false,
  "remoteUser": "agent",
  "updateRemoteUserUID": true,
  "initializeCommand": "scripts/engine.sh preflight",
  "postCreateCommand": "just _post-create",
  "postStartCommand": "just _post-start",
  "waitFor": "postStartCommand",
  "customizations": {
    "vscode": {
      "extensions": []
    }
  }
}
