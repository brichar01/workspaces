# Copy to .env (`just init` does this for you). Never commit .env.

# Compose project and image names. `just new-workspace` sets both to the
# workspace name. They must be unique per workspace on this host.
COMPOSE_PROJECT_NAME=example-workspace
WORKSPACES_BASE_IMAGE=workspaces_base:dev
WORKSPACE_IMAGE=example-workspace:dev

# --- extensions --------------------------------------------------------------
# Space-separated directory names from WORKSPACES_EXTENSIONS_DIR, which is the
# extensions/ directory of a project checkout (see AGENTS.md). Run
# `just rebuild` after changing either.
# WORKSPACES_EXTENSIONS="pi claude"
# WORKSPACES_EXTENSIONS_DIR=/path/to/workspaces/project/extensions

# --- credentials (uncomment and fill, or inject from a secret manager) ------
# These are visible to processes inside the container. Prefer short-lived tokens.
# claude:
# ANTHROPIC_API_KEY=
# ANTHROPIC_OAUTH_TOKEN=
# pi:
# MISTRAL_API_KEY=
