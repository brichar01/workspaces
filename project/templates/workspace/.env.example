# Copy to .env (`just init` does this for you). Never commit .env.

# Compose project and image names.
COMPOSE_PROJECT_NAME=hive-workspace
HIVE_BASE_IMAGE=hive-base:dev
WORKSPACE_IMAGE=hive-workspace:dev

# Where the base project checkout lives, relative to this workspace.
HIVE_PROJECT_DIR=../project

# --- credentials (uncomment and fill, or inject from a secret manager) ------
# These are visible to processes inside the container. Prefer short-lived tokens.
# ANTHROPIC_API_KEY=
# ANTHROPIC_OAUTH_TOKEN=
# HIVE_AGENT_API_KEY=
# MISTRAL_API_KEY=
